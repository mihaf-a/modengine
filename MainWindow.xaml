<Window x:Class="ModEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModEngine"
        mc:Ignorable="d"
        Title="ModEngine — Garry's Mod Workshop Installer"
        Height="550" Width="790"
        MinHeight="450" MinWidth="620"
        Background="#1A1A1A"
        WindowStartupLocation="CenterScreen"
        ToolTipService.InitialShowDelay="100"
        ToolTipService.ShowDuration="30000">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A7BD5"/>
            <Setter Property="BorderBrush" Value="#2E60A8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8B2020"/>
            <Setter Property="BorderBrush" Value="#6B1818"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D7D3A"/>
            <Setter Property="BorderBrush" Value="#1F5C28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#5B2D8E"/>
            <Setter Property="BorderBrush" Value="#3F1D66"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                <TextBlock x:Name="PlaceholderText" Text="{TemplateBinding Tag}" Foreground="#666" FontFamily="Segoe UI" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="BorderBrush" Value="#3A7BD5"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="4"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3" Margin="0,1">
                                        <ContentPresenter Margin="4,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3A7BD5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#00fc19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_INDICATOR" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="16" Height="16" Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="#3A7BD5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#3A7BD5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <TextBlock Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}, Path=Text}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,20,0"/>
                                                <TextBlock Text="▼" Foreground="#666" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" AllowsTransparency="True">
                                <Border Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A7BD5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#3A7BD5"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- nav bar -->
        <Border Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,0,1" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="InstallerTabBtn" Content="Installer" Style="{StaticResource NavTabStyle}" Foreground="#E0E0E0" BorderBrush="#3A7BD5" Click="InstallerTab_Click" ToolTip="Installer — paste IDs and install addons (Ctrl+1)"/>
                    <Button x:Name="ManagerTabBtn" Content="Manager" Style="{StaticResource NavTabStyle}" Click="ManagerTab_Click" ToolTip="Manager — browse, sort, update, and manage installed addons (Ctrl+2)"/>
                    <Button x:Name="BackupsTabBtn" Content="Backups" Style="{StaticResource NavTabStyle}" Click="BackupsTab_Click" ToolTip="Backups — restore or delete backed-up addon versions (Ctrl+3)"/>
                    <Button x:Name="SettingsTabBtn" Content="Settings" Style="{StaticResource NavTabStyle}" Click="SettingsTab_Click" ToolTip="Settings — configure game directory, SteamCMD path, and more (Ctrl+4)"/>
                </StackPanel>
                <Button x:Name="CreditsButton" Content="?" Width="28" Height="28" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Foreground="#555" Click="CreditsButton_Click" ToolTip="Credits"/>
            </Grid>
        </Border>

        <!-- installer tab -->
        <Grid x:Name="InstallerTab" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkshopInput" Grid.Column="0" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="14" Tag="Paste Workshop ID, URL, or collection link…" ToolTip="Paste a workshop URL or numeric ID and press Enter or click + Add"/>
                <Button x:Name="AddButton" Grid.Column="1" Content="+ Add" Width="90" Height="34" Click="AddButton_Click" ToolTip="Add the workshop item to the install queue (Enter)"/>
            </Grid>
            <CheckBox x:Name="ForceReinstallCheckbox" Grid.Row="1" Content="Force reinstall (ignore installed check)" Margin="2,0,0,6" ToolTip="Re-download and reinstall even if the addon is already installed"/>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="InstallButton" Grid.Row="0" Grid.Column="0" Content="Install Queue" Height="36" Style="{StaticResource AccentButton}" Click="InstallButton_Click" ToolTip="Download and install all addons in the queue"/>
                <Button x:Name="CancelButton" Grid.Row="0" Grid.Column="2" Content="Cancel" Height="36" IsEnabled="False" Style="{StaticResource DangerButton}" Click="CancelButton_Click" ToolTip="Stop the current installation"/>
                <ProgressBar x:Name="MainProgressBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="ProgressLabel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Foreground="#888" FontSize="11" HorizontalAlignment="Right" Margin="0,10,0,0" Text="Idle"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,4">
                        <TextBlock Text="QUEUE" Foreground="#666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" (drag &amp; drop links here)" Foreground="#555" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="QueueList" SelectionMode="Extended" ToolTip="Right-click to remove items — drag &amp; drop workshop links here"/>
                        <TextBlock x:Name="QueueEmptyText" Text="Queue is empty. Paste a workshop link above." Foreground="#555" FontSize="12" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="ClearQueueButton" Grid.Row="2" Content="Clear Queue" Height="28" Margin="0,6,0,0" Click="ClearQueueButton_Click" ToolTip="Remove all items from the queue"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="LOG" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,0"/>
                        <Button x:Name="ClearLogButton" Content="Clear" Width="50" Height="20" HorizontalAlignment="Right" FontSize="11" Click="ClearLogButton_Click" ToolTip="Clear the log output"/>
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#333" Padding="6"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- manager tab -->
        <Grid x:Name="ManagerTab" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="MANAGER" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ManagerSearchBox" Grid.Column="0" Height="30" Tag="Search addons…" TextChanged="ManagerSearchBox_TextChanged" ToolTip="Search by addon name or workshop ID (Ctrl+F to focus)"/>
                    <ComboBox x:Name="SortComboBox" Grid.Column="2" Height="30" SelectionChanged="SortComboBox_SelectionChanged" ToolTip="Sort addons by name, date, or size">
                        <ComboBoxItem Content="Name A-Z" IsSelected="True"/>
                        <ComboBoxItem Content="Name Z-A"/>
                        <ComboBoxItem Content="Newest"/>
                        <ComboBoxItem Content="Oldest"/>
                        <ComboBoxItem Content="Largest"/>
                        <ComboBoxItem Content="Smallest"/>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ManualAddButton" Grid.Column="0" Content="+ Add" Height="28" FontSize="11" Click="ManualAddButton_Click" ToolTip="Manually add an addon to the manager by workshop ID"/>
                    <Button x:Name="ScanForAddonsButton" Grid.Column="2" Content="Scan" Height="28" FontSize="11" Style="{StaticResource PurpleButton}" Click="ScanForAddonsButton_Click" ToolTip="Scan your garrysmod/addons folder for addons not yet tracked"/>
                    <Button x:Name="CheckForUpdatesButton" Grid.Column="4" Content="Updates" Height="28" FontSize="11" Style="{StaticResource AccentButton}" Click="CheckForUpdatesButton_Click" ToolTip="Check the Steam Workshop for newer versions of your addons"/>
                    <Button x:Name="UpdateAllButton" Grid.Column="6" Content="Update All" Height="28" FontSize="11" Style="{StaticResource GreenButton}" Click="UpdateAllButton_Click" ToolTip="Queue all outdated addons for reinstall at once"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExportButton" Grid.Column="0" Content="Export" Height="26" FontSize="10" Click="ExportButton_Click" ToolTip="Export your addon list to a JSON file for backup or sharing"/>
                    <Button x:Name="ImportButton" Grid.Column="2" Content="Import" Height="26" FontSize="10" Click="ImportButton_Click" ToolTip="Import an addon list from a JSON file and queue them for install"/>
                    <Button x:Name="DeleteAllButton" Grid.Column="4" Content="Del All" Height="26" FontSize="10" Style="{StaticResource DangerButton}" Click="DeleteAllButton_Click" ToolTip="Delete ALL tracked addons from disk — this cannot be undone"/>
                    <Button x:Name="ClearListButton" Grid.Column="6" Content="Clear List" Height="26" FontSize="10" Click="ClearListButton_Click" ToolTip="Remove all addons from the manager list but keep the files on disk"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SavePresetButton" Grid.Column="0" Content="Save" Width="55" Height="26" FontSize="10" Style="{StaticResource GreenButton}" Click="SavePresetButton_Click" ToolTip="Save your current addon list as a named preset for later"/>
                    <ComboBox x:Name="PresetComboBox" Grid.Column="1" Height="26" ToolTip="Select a saved preset to load or delete"/>
                    <Button x:Name="LoadPresetButton" Grid.Column="3" Content="Load" Width="55" Height="26" FontSize="10" Style="{StaticResource AccentButton}" Click="LoadPresetButton_Click" ToolTip="Load the selected preset — replaces all current addons"/>
                    <Button x:Name="DeletePresetButton" Grid.Column="5" Content="Del" Width="45" Height="26" FontSize="10" Style="{StaticResource DangerButton}" Click="DeletePresetButton_Click" ToolTip="Delete the selected preset"/>
                </Grid>
                <WrapPanel x:Name="TagTabsPanel" Grid.Row="5" Margin="0,0,0,4"/>
                <Grid Grid.Row="6">
                    <ListBox x:Name="ManagerListBox" DisplayMemberPath="Title" SelectionMode="Extended" SelectionChanged="ManagerListBox_SelectionChanged" ToolTip="Double-click an addon to queue it for reinstall — right-click for more options"/>
                    <TextBlock x:Name="ManagerEmptyText" Text="No addons tracked yet. Install some or scan your game folder." Foreground="#555" FontSize="12" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20,0" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="ManagerStatsLabel" Grid.Row="7" Text="0 addons — 0 bytes" Foreground="#555" FontSize="10" Margin="2,3,0,0"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Background="#242424" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel">
                        <TextBlock x:Name="NoSelectionText" Text="Select an addon from the list to view details.&#x0a;Double-click to reinstall." Foreground="#666" FontSize="13" TextWrapping="Wrap"/>
                        <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                            <Image x:Name="DetailLogo" Width="200" Height="112" Stretch="UniformToFill" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="Fant"/>
                            <TextBlock x:Name="DetailTitle" Foreground="#E0E0E0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="DetailId" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ViewOnWorkshopLink" Text="View on Workshop" Foreground="#3A7BD5" FontSize="11" Cursor="Hand" TextDecorations="Underline" Margin="10,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="ViewOnWorkshop_Click" ToolTip="Open this addon's Workshop page in your browser"/>
                            </StackPanel>
                            <Border x:Name="UpdateAvailableWarning" Background="#1A2D3D" BorderBrush="#2E60A8" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬆" Foreground="#4A8BE5" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Update available on Workshop" Foreground="#4A8BE5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ConflictWarning" Background="#3D2A1A" BorderBrush="#8B6914" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="⚠ CONFLICT DETECTED" Foreground="#FFB347" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="ConflictList" Foreground="#DDD" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="DetailDescription" Foreground="#AAA" FontSize="12" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ExpandDescriptionBtn" Text="Show full description" Foreground="#3A7BD5" FontSize="11" Cursor="Hand" TextDecorations="Underline" Margin="0,0,0,12" MouseLeftButtonDown="ExpandDescription_Click" ToolTip="Click to show or hide the full addon description"/>
                            <TextBlock x:Name="DetailSize" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailDate" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailPath" Foreground="#666" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="OpenFolderButton" Content="Open Folder" Width="100" Height="30" Margin="0,0,8,0" Click="OpenFolderButton_Click" ToolTip="Open the addon folder in File Explorer"/>
                                <Button x:Name="DeleteAddonButton" Content="Delete Addon" Width="110" Height="30" Margin="0,0,8,0" Style="{StaticResource DangerButton}" Click="DeleteAddonButton_Click" ToolTip="Delete this addon from disk permanently"/>
                                <Button x:Name="RemoveFromListButton" Content="Remove from List" Width="130" Height="30" Click="RemoveFromListButton_Click" ToolTip="Remove from manager but keep the addon files on disk"/>
                            </StackPanel>
                            <Button x:Name="RestoreBackupButton" Content="Restore Backup" Width="130" Height="28" Style="{StaticResource GreenButton}" FontSize="12" Visibility="Collapsed" Click="RestoreBackupButton_Click" ToolTip="Restore the previous version of this addon from backup"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- backups tab -->
        <Grid x:Name="BackupsTab" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="BACKUPS" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="DeleteAllBackupsButton" Content="Delete All" Width="80" Height="28" Style="{StaticResource DangerButton}" FontSize="11" Click="DeleteAllBackupsButton_Click" ToolTip="Delete all backup folders to free up disk space"/>
                </StackPanel>
                <ListBox x:Name="BackupListBox" Grid.Row="2" DisplayMemberPath="DisplayText" SelectionChanged="BackupListBox_SelectionChanged" ToolTip="Backups are created automatically when you reinstall an addon"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Background="#242424" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="BackupNoSelection" Text="Select a backup from the list to view details." Foreground="#666" FontSize="13" TextWrapping="Wrap"/>
                        <StackPanel x:Name="BackupDetail" Visibility="Collapsed">
                            <TextBlock x:Name="BackupDetailTitle" Foreground="#E0E0E0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="BackupDetailId" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                            <TextBlock x:Name="BackupDetailDate" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BackupDetailSize" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BackupDetailPath" Foreground="#666" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RestoreBackupFromTabBtn" Content="Restore" Width="80" Height="30" Margin="0,0,8,0" Style="{StaticResource GreenButton}" FontSize="12" Click="RestoreBackupFromTab_Click" ToolTip="Restore this backup — replaces the current addon version"/>
                                <Button x:Name="DeleteBackupButton" Content="Delete" Width="80" Height="30" Margin="0,0,8,0" Style="{StaticResource DangerButton}" FontSize="12" Click="DeleteBackupButton_Click" ToolTip="Delete this backup permanently"/>
                                <Button x:Name="OpenBackupFolderButton" Content="Open Folder" Width="100" Height="30" Click="OpenBackupFolderButton_Click" ToolTip="Open the backup folder in File Explorer"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- settings tab -->
        <Grid x:Name="SettingsTab" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="SETTINGS" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,10"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="500">
                    <Border Background="#242424" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Game Directory" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="The garrysmod/addons folder where addons are installed." Foreground="#666" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsGameDirBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" FontSize="13" ToolTip="Full path to your garrysmod/addons folder"/>
                                <Button x:Name="BrowseGameDirButton" Grid.Column="2" Content="Browse" Width="80" Height="34" Click="BrowseGameDirButton_Click" ToolTip="Open the folder in Explorer so you can copy the path"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#242424" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SteamCMD Path" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Where steamcmd.exe is located. Auto-detected, change only if you moved it." Foreground="#666" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsSteamCmdBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" FontSize="13" ToolTip="Full path to steamcmd.exe"/>
                                <Button x:Name="BrowseSteamCmdButton" Grid.Column="2" Content="Browse" Width="80" Height="34" Click="BrowseSteamCmdButton_Click" ToolTip="Browse to locate steamcmd.exe"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#242424" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Max Parallel Installs" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="How many addons to extract at once. Higher = faster but more CPU usage." Foreground="#666" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsMaxWorkersSlider" Grid.Column="0" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SettingsMaxWorkersSlider_ValueChanged" ToolTip="Number of addons to process simultaneously (1 = slowest, 5 = fastest)"/>
                                <TextBlock x:Name="SettingsMaxWorkersLabel" Grid.Column="1" Text="3" Foreground="#E0E0E0" FontSize="16" FontWeight="SemiBold" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#242424" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Auto-clear Queue" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Automatically clear the queue after a successful install." Foreground="#666" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <CheckBox x:Name="SettingsAutoClearCheckbox" Content="Enable auto-clear" ToolTip="When enabled, the queue will be cleared automatically after all addons install successfully"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SaveSettingsButton" Content="Save Settings" Height="42" Style="{StaticResource AccentButton}" FontSize="14" HorizontalAlignment="Right" Click="SaveSettingsButton_Click" ToolTip="Save all settings to config.json"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="2" Background="#141414" CornerRadius="3" Margin="0,8,0,0" Padding="8,4">
            <Grid>
                <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#666" FontSize="11"/>
                <TextBlock x:Name="QueueCountLabel" Text="0 items in queue" Foreground="#555" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>